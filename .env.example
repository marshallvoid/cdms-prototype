MOCK_PRODUCT_COUNT=200
MOCK_SEED=42
MOCK_DEFAULT_PAGE_SIZE=10
MOCK_MUTATION_INTERVAL=0
MOCK_CDMS_WEBHOOK_URL=http://cdms:8001/api/v1/webhooks/inventory
